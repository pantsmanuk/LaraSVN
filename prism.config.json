{
  "theme": "prism.min.css",
  "darkTheme": "prism-tomorrow.min.css",
  "languages": {
    "pascal": ["pas", "pp", "dpr", "dpk", "lpr", "dfm", "lfm"],
    "php": ["php", "phtml"],
    "javascript": ["js", "mjs", "cjs"],
    "typescript": ["ts", "mts", "cts"],
    "jsx": ["jsx"],
    "tsx": ["tsx"],
    "json": ["json", "jsonc"],
    "markup": ["html", "htm", "xhtml", "xml", "svg", "xsd", "xsl", "xslt", "dproj", "csproj", "vbproj", "resx", "plist"],
    "css": ["css"],
    "scss": ["scss"],
    "less": ["less"],
    "c": ["c", "h"],
    "cpp": ["cpp", "cc", "cxx", "hpp", "hh", "hxx"],
    "csharp": ["cs"],
    "vbnet": ["vb"],
    "python": ["py", "pyw"],
    "ruby": ["rb", "rake"],
    "java": ["java"],
    "go": ["go"],
    "rust": ["rs"],
    "sql": ["sql"],
    "bash": ["sh", "bash", "zsh"],
    "powershell": ["ps1", "psm1", "psd1"],
    "yaml": ["yaml", "yml"],
    "toml": ["toml"],
    "ini": ["ini", "cfg"],
    "markdown": ["md", "markdown"],
    "diff": ["diff", "patch"]
  },
  "plugins": [
    "line-numbers",
    "match-braces",
    "show-language",
    "copy-to-clipboard",
    "inline-color",
    "diff-highlight",
    "normalize-whitespace",
    "show-invisibles",
    "previewers"
  ]
}
