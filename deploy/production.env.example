# Based on copied production WebSVN/Apache settings. Review before deployment.
# This file is a template; the running local .env is not changed.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://svn.ggpsystems.co.uk/websvn
APP_KEY=GENERATE_ON_THE_SERVER
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Matches WebSVN parentPath. Directory discovery happens for each request.
SVN_PARENT_PATH=/home/svn/repositories
# Optional explicit repository overrides; leave empty for parent discovery alone.
SVN_REPOSITORIES_FILE=
# Acknowledges every visible/readable root below the parent, including linked roots.
SVN_PUBLIC_READ=true
# Matches active addInlineMimeType('text/plain').
SVN_SOURCE_MIME_TYPES=text/plain

SVN_PROCESS_SECONDS=15
SVN_REQUEST_SECONDS=30
SVN_SOURCE_LINES=20000
SVN_DISPLAY_BYTES=2000000
SVN_DOWNLOAD_BYTES=20000000
SVN_ARCHIVE_BYTES=22000000
SVN_DOWNLOAD_ENTRIES=1000
