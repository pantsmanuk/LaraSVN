{
    "name": "larasvn/larasvn",
    "type": "project",
    "description": "Read-only SVN browser with Laravel and PrismJS.",
    "require": {
        "php": "^8.4.1",
        "ext-phar": "*",
        "ext-simplexml": "*",
        "ext-xmlwriter": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php artisan test",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "verify": [
            "Composer\\Config::disableProcessTimeout",
            "npm run build",
            "@php artisan test --compact",
            "npm test",
            "vendor/bin/pint app config routes tests bootstrap/app.php bootstrap/providers.php scripts/render-request.php --test",
            "@php artisan svn:check --repository=fixture"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
