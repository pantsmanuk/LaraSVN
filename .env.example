APP_NAME=LaraSVN
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_CHANNEL=single
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Configure JSON and/or a parent path outside local/testing; keep JSON outside public.
SVN_REPOSITORIES_FILE=
# Alternative: discover local repositories on each request; no fixture fallback.
SVN_PARENT_PATH=
# Optional comma-separated source MIME overrides. Production WebSVN uses text/plain.
# SVN_SOURCE_MIME_TYPES=text/plain
# Acknowledges every configured root and its entire history are public.
SVN_PUBLIC_READ=false
SVN_PROCESS_SECONDS=15
SVN_REQUEST_SECONDS=30
SVN_SOURCE_LINES=20000
SVN_DISPLAY_BYTES=2000000
SVN_DOWNLOAD_BYTES=20000000
SVN_ARCHIVE_BYTES=22000000
SVN_DOWNLOAD_ENTRIES=1000
